# Python
__pycache__/
*.py[cod]
*.egg-info/

# 打包产物
build/
dist/
*.manifest

# 运行数据（配置里含 API Key、还有学习库/缓存/日志，绝对不要提交）
data/
# 公共词典的成品放在 `dict` 分支（客户端从那里拉），主分支只保留生成脚本
dictionary/
*.log

# 发布流程用的临时文件
release_id.txt

# 发布签名私钥（拿到它就能签出"验得过"的假安装包）——永远不要提交
.ddo-release/
*.key

# 插件生成的产物（示例插件写出来的 Markdown 等）
plugins/*/output/
# 插件自己缓存的抓取结果 / 译文
plugins/*/cache/

# 编辑器
.vscode/
.idea/
*.swp
